# -----------------------------------------------------------------------
# Sahayak backend environment variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# -----------------------------------------------------------------------

# Azure AI Foundry — Person 1 fills these in
AZURE_AI_PROJECT_CONNECTION_STRING=your_connection_string_here
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o
SAHAYAK_AGENT_ID=your_agent_id_here

# Azure credentials (use managed identity in production)
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=

# Backend server settings
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_RELOAD=true

# CORS — add the React dev server origin
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
